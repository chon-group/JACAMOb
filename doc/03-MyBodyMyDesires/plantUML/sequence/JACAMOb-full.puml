@startuml
title Diagrama de Fluxo Temporal entre Componentes do JACAMOb

actor Designer
participant JaCaMo
participant NECK
participant DEVICE
participant RealWorld
participant Jason
participant JaCa
participant CArtAgO
participant ORA4MAS
participant Moise
participant NPL
participant SAI



Jason -> Jason : infra.local.LocalAgArch.run
== Ciclo de vida dos agentes ==


group jason.infra.local.LocalAgArch.reasoningCycle()

    group jason.infra.local.LocalAgArch.sense
        Jason -> JaCa : asSemantics.TransitionSystem.sense
        activate Jason
        activate JaCa
        JaCa -> JaCa : CAgentArch.perceive
        activate JaCa
        JaCa -> JaCa : CAgentArch.perceiveActionSucceeded
        JaCa -> JaCa : CAgentArch.perceiveActionFailed
        JaCa -> JaCa : CAgentArch.perceiveDispose
        JaCa -> JaCa : CAgentArch.perceiveSignal
        JaCa -> JaCa : CAgentArch.perceivedChangedOP
        JaCa -> JaCa : CAgentArch.perceiveAddedOP
        JaCa -> JaCa : CAgentArch.perceiveRemovedOP
        return
        JaCa -> Jason : CAgentArch.addObsPropertiesBel
        activate Jason
        Jason -> Jason : bb.DefaultBeliefBase.add
        return
        return
        
        Jason -> JaCaMo : architecture.AgArch.perceive
        activate JaCaMo
        JaCaMo -> NECK : infra.JaCaMoAgArch.perceive
        activate NECK
        group #FFF2CC percepcao Corporal
            NECK -> NECK : Body.sense
            activate NECK
            NECK -> DEVICE : Apparatus.sense
            activate DEVICE
            DEVICE -> DEVICE :  JSON_SLP.incoming()
            DEVICE -> DEVICE : Apparatus.streamPercepts()
            return

            NECK -> Jason : Body.updatePercepts
            activate Jason
            Jason -> Jason : bb.DefaultBeliefBase.add
            return

            NECK -> Jason : Body.updateDesires
            activate Jason
            Jason -> Jason : asSemantics.Circumstance.addEvent
            return
            return
        end
        return
        return

        
        Jason -> Jason : architecture.AgArch.checkMail
        activate Jason
        Jason -> Jason : asSemantics.Circumstance.addEvent
        return
        deactivate Jason

    end

    group deliberate
    Jason -> Jason : asSemantics.TransitionSystem.deliberate
    activate Jason
        Jason -> Jason: asSemantics.TransitionSystem.applySelEv();
        Jason -> Jason: asSemantics.TransitionSystem.applyRelPl();
        Jason -> Jason: asSemantics.TransitionSystem.applyApplPl();
        Jason -> Jason: asSemantics.TransitionSystem.applySelAppl();
        Jason -> Jason: asSemantics.TransitionSystem.applyFindOp();
        Jason -> Jason: asSemantics.TransitionSystem.applyAddIM();
    return
    end

    group jason.infra.local.LocalAgArch.act
    Jason -> Jason : infra.local.LocalAgArch.act
    end



end

deactivate JaCaMo

@enduml


