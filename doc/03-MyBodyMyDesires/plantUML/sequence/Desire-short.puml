@startuml
title Diagrama de Fluxo Temporal entre Componentes do JACAMOb

participant JaCaMo
participant Jason
participant NECK
participant Apparatus





== Agent's life cycle ==


group jason.infra.local.LocalAgArch.reasoningCycle()

    group jason.infra.local.LocalAgArch.sense()

        activate JaCaMo
        JaCaMo -> NECK : infra.JaCaMoAgArch.perceive
        activate NECK
        group #FFF2CC Body Perception
            NECK -> NECK : Body.sense
            activate NECK
            NECK -> Apparatus : Apparatus.sense
            activate Apparatus
            Apparatus -> Apparatus :  JSON_SLP.incoming()
            Apparatus -> Apparatus : Apparatus.streamPercepts()
            return

            NECK -> Jason : Body.updatePercepts
            activate Jason
            Jason -> Jason : bb.DefaultBeliefBase.add
            return

            NECK -> Jason : Body.updateDesires
            activate Jason
            Jason -> Jason : asSemantics.Circumstance.addEvent
            return
            return
        end
        return


        
 

    end



end

deactivate JaCaMo

@enduml


