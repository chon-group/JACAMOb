mas desireWithCArtAgO {

    agent rosie {
        focus: myBody.battery
    }

    workspace myBody {
        artifact battery: body.Battery("/dev/ttyEmulatedPort0")
    }

    uses package: javino "com.github.chon-group:Javino:1.6.7"
}