
@startuml

top to bottom direction
skinparam classAttributeIconSize 0
skinparam packageStyle folder
 skinparam linetype ortho
 skinparam nodesep 25
 skinparam ranksep 50
 hide empty members

package "neck2arduino" {
    package "NECK" {
        package "DSL" as NECK_DSL {

            metaclass "Apparatus" as DSLApparatus <<macro>> {}
            metaclass "Element" as DSLElement <<macro>> {}
            
            metaclass "Act" as DSLAct <<macro>>  {}

            DSLApparatus "1" *-- "0..*" DSLElement
            
        }

        package "CORE" as NECK_CPP {

            class "ActionFn" as ActionFn <<typedef>> #MistyRose {
                Response (*)(const NECKArgs&)
            }

            struct "ActionEntry" as ActionEntry #MistyRose {
                + elementName : const char*
                + actionName : const char*
                + fn : ActionFn
                + next : ActionEntry*
            }




            enum "Response" as Response #MistyRose {
            <color:red>ALREADY</color>
            EXECUTED
            <color:red>INVALID</color>
            PERCEPTED
            <color:red>REJECTED</color>
            <color:red>UNABLE</color>
            UNAVAILABLE
            UNCHANGED
            <color:red>UNKNOWN</color>
            }

            class NECKArgs #MistyRose {

            }


            class "Apparatus" as Apparatus {
                - _jslp : JSON_SLP
                - _actions : ActionEntry*
                - _percepts : PerceptionEntry*
                - _sensings : SensingEntry*
                - _behavings : BehavingEntry*
                - _apparatusID : uint32_t
                + Apparatus(name : const char*)
                + name() : const char*
                --
                + {static} setPreparation(fn : PreparationFn) : void
                + <color:red>addAction(elementName : const char*, actionName : const char*, fn : ActionFn) : void</color>
                + addPerception(elementName : const char*, perceptName : const char*, type : PerceptionType, fn : PerceptionFn) : void
                + addSensing(elementName : const char*, fn : SensingFn) : void
                + addBehaving(elementName : const char*, fn : BehavingFn) : void
                + addTrieb(const char* elementName, const char* triebName, TriebFn fn) : void
                
                + {static} prepare() : void
                + embody() : void
                + bodyCycle() : void
                + <color:orange><b>inhabitance() : void</b></color>
                + streamPercepts() : void
                + <color:red>streamActions(onlyElement : const char*) : void</color>
                + <color:red>streamAction(action : String, element : String, args : NECKArgs) : void</color>

                - perceive(entry : PerceptionEntry*) : PerceptReturn
                - sendHeader(request : const char*, response : Response) : void
                - <color:red>sendActionResultJSON(elementName : const char*, actionName : const char*, response : Response) : void</color>
                - <color:red>dispatchActionUnicast(elementName : const char*, actionName : const char*, args : const NECKArgs&) : Response</color>
                - <color:red>dispatchActionBroadcast(actionName : const char*, args : const NECKArgs&) : bool</color>
            }

            ' Registros gerenciados pelo Apparatus
            Apparatus ..> Response

            

            
        }

        DSLApparatus ..down.> Apparatus
        
        
    }

    package "JsonOverSLP" {
        class "JSON_SLP" as JSON_SLP {
        }
    }

    DSLAct ..> DSLElement
    DSLAct ..> ActionEntry
    Apparatus "1" *-- "0..*" ActionEntry
    ActionEntry --> ActionFn
    ActionFn ..> Response
    ActionFn ..> NECKArgs

    Apparatus *-- JSON_SLP
}

@enduml
