@startuml

  top to bottom direction

 skinparam classAttributeIconSize 0
 skinparam packageStyle folder
 skinparam linetype ortho
 skinparam linetype ortho
 skinparam nodesep 60
 skinparam ranksep 80

package org{
  package json{
    class JSONObject
  }
}



' ============================================================
' JASON
' ============================================================
package jason {

  package "stdlib" {
    package "myBody" {
        class "act" as myBodyAct #MistyRose
    }
  }

  package "asSemantics" as pkg_jason_semantics {

      class "TransitionSystem" as TransitionSystem

      class "DefaultInternalAction" as DefaultInternalAction {
          + execute(ts: TransitionSystem, un: Unifier, args: Term[]): Object
      }

  }

  package "asSyntax" as pkg_jason_syntax {

    interface "Term" as Term

    class "Literal" as Literal

    Literal ..|> Term

  }
}





' ============================================================
' JACAMO
' ============================================================
package jacamo {



  package "infra" as pkg_infra {
    class "JaCaMoAgArch" as JaCaMoAgArch {
    }
  }

}

' ============================================================
' NECK
' ============================================================

package "neck" as pkg_neck {

  
  package "model" as pkg_model {
    enum "PerceptionType" as PerceptionType  {}

    enum "ApparatusResponse" as ApparatusResponse  {
        <color:red>ALREADY</color>
        EXECUTED
        <color:red>INVALID</color>
        PERCEPTED
        <color:red>REJECTED</color>
        <color:red>UNABLE</color>
        UNAVAILABLE
        UNCHANGED
        <color:red>UNKNOWN</color>
        --
        {static} + toApparatusResponse(jsonObject : JSONObject): ApparatusResponse
        {static} + toApparatusResponse(bodyResponse : String): ApparatusResponse
        + toTerm(): Term
        <color:red>+ toERRORTerm(): Term</color>
    }
  }

  package "internalActions" as internalActions {
    class "BodyAct" as Act #MistyRose {
    +getMinArgs(): int
    +getMaxArgs(): int
    #checkArguments(args: Term[]): void
    +execute(ts: TransitionSystem, un: Unifier, args: Term[]): Object
    {static} -currentAgtBody(ts: TransitionSystem): Body
    }
  }

  Act <|-- myBodyAct

  class "Body" as Body {

      - apparatus : neck.Apparatus[]
      - bodyName : String

      + Body(bodyName : String)

      + <color:red>act(actionTerm: Term, apparatusName: Atom): ApparatusResponse</color>      
      + attachApparatus(implementation : neck.Apparatus, apparatusName : String) : boolean
      + detachApparatusByName(apparatusName : String) : boolean
      + perceive(transitionSystem : TransitionSystem) : void

      - getApparatus(appName : Atom) : Apparatus
      - <color:red>getApparatusBySupportedAction(actionName: Term): Apparatus</color>
      - bodyPerceptionRevisionFunction(List<Literal> incoming) : List<Literal>
      - removeOldPerceptions(List<Literal> bodyBeliefs, List<Literal> perceived, TransitionSystem ts) : void
      - addNewPerceptions(List<Literal> bodyBeliefs, List<Literal> perceived, TransitionSystem ts) : void


  }

  Act ..> TransitionSystem 

  Apparatus ..> ApparatusResponse
  ApparatusResponse ..> Term
  Apparatus ..> Literal



  abstract class "Apparatus" as Apparatus {

      - apparatusName : String
      - hwAppName : String
      - hwAppID : Long
      - interoceptions : List<Literal>
      - exteroceptions : List<Literal>
      - proprioceptions : List<Literal>
      - <color:red>supportedActions: Set<String></color>

      # Apparatus()
      {abstract} + <color:red>act(actionTerm: Term): ApparatusResponse</color>
      + attach() : void
      + detach() : void
      + embody() : JSONObject
      + sense() : void

      # init() : void
      {abstract} # <color:red>requestActions(): JSONObject</color>
      # requestPercepts() : JSONObject

      + getAllPerceptions() : List<Literal>
      + getStatus() : boolean
      + getConnectionStatus() : String
      + getAddress() : String
      + getHwAppName() : String
      + getApparatusName() : String
      + setApparatusName(apparatusName : String) : void
      + <color:red>supportsAction(actionName: String): boolean</color>
      - <color:red>loadBodyActions(): void</color>
      
      
    }
    
    


    package "defaults" as pkg_defaults {
      class "SerialApparatus" as SerialApparatus {

      - serialComm : neck.util.SerialComm

      + SerialApparatus(address : String)

      + <color:red>act(actionTerm: Term): ApparatusResponse</color>
      + attach() : void
      + detach() : void
      + embody() : JSONObject
      # <color:red>requestActions() : JSONObject</color>
      + requestPercepts() : JSONObject

      + getStatus() : boolean
      + getConnectionStatus() : String
      + getAddress() : String
      
      - request(message : String, args : Object[]) : JSONObject
      - prepareRequest(message : String, args : Object[]) : JSONObject
      - parseResponse(records : List<JSONObject>) : JSONObject
      }

      
    }

  
}


' ============================================================
' RELAÇÕES
' ============================================================

' A ação interna do NECK estende a ação interna padrão do Jason
Act --|> DefaultInternalAction

' ' A ação interna acessa o corpo pela arquitetura do agente
 Act ..> JaCaMoAgArch
' Act ..> Body

' ' A ação interna utiliza a resposta corporal
' Act ..> ApparatusResponse


Act ..[norank]> Body
Act ..[norank]> ApparatusResponse


Apparatus ..> PerceptionType

JaCaMoAgArch "1" --> "0..1" Body 

Body "1" o-- "1..*" Apparatus

SerialApparatus --|> Apparatus

JSONObject <..SerialApparatus

' ============================================================
' ORGANIZAÇÃO VISUAL
' ============================================================

' Model à esquerda do Apparatus
ApparatusResponse -[hidden]right- Apparatus

' Jason abaixo do NECK
Apparatus -[hidden]down- Literal

' JaCaMo acima do NECK
JaCaMoAgArch -[hidden]down- Body
@enduml
