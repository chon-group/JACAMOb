/*
  Dependences...
  Add it in your root build.gradle at the end of repositories:
  repositories {
      maven { url "https://raw.github.com/embedded-mas/embedded-mas-mvn-repo/master" } // <-- new repo
  }
  dependencies {
      implementation "embedded-mas:embedded-mas:0.061-SNAPSHOT"  // <-- new dependence
  }
*/

mas proofJaCaMoAndJasonROS {

  agent rosie{
    join: livingRoom
    focus: livingRoom.presenceSensor
    focus: livingRoom.airConditioner
    roles: housekeeper in householdStaff
    ag-class: embedded.mas.bridges.jacamo.CyberPhysicalAgent      
    ag-arch: embedded.mas.bridges.jacamo.DefaultEmbeddedAgArch
  }

  workspace livingRoom {
    artifact presenceSensor : jetsons.home.PresenceSensor()
    artifact airConditioner : jetsons.home.AirConditioner()
  }

  organisation jetsonsFamily : jetsons.xml {
    group householdStaff : householdGroup {
    responsible-for: cleaning
    }
    scheme cleaning : cleaningScheme
  }
}