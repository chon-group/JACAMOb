mas jacamoProject{
    agent rosie {
        body :
            apparatus ap2 : neck.defaults.SerialApparatus("/dev/ttyACM0")
        join: livingRoom
        focus: livingRoom.airConditioner
        focus: livingRoom.light
        beliefs: ecoMode(on)
        goals: saveBattery

        focus: jetsonsInstitution.jetsonsInstitution_art
        roles: housekeeper in householdStaff
  //      ag-class: customizedAgent.MyAgent
  //      ag-arch: customizedAgent.MyAgArch
    }

   /* body rosie {
        //apparatus ap1 : neck.defaults.SerialApparatus("/dev/ttyACM0")
    }*/
    
   workspace livingRoom {
        artifact airConditioner : jetsons.home.AirConditioner()
        artifact light : jetsons.home.Light()
    }

    institution jetsonsInstitution : jetsonsInst.sai {
        workspaces: livingRoom
    }

    organisation jetsonsFamily : jetsons.xml {
        group householdStaff : householdGroup {
            responsible-for: cleanHouse
        }
        scheme cleanHouse : cleaningScheme
        situated: jetsonsInstitution
    }
    
    
}