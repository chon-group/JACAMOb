== INCIO DO CARREGAMENTO O SISTEMA MULTIAGENTE ==

    group infra.JaCaMoLauncher.create()

        group #faf6f1 Dimensão Ambiental
            JaCaMo -> JaCa : jacamo.platform.Cartago.init()
            activate JaCa
            JaCa -> CArtAgO : CartagoEnvironment.init()
            activate CArtAgO
            CArtAgO -> CArtAgO : WorkspaceId.<init>
            CArtAgO -> CArtAgO : Workspace.makeArtifact()
            return
            return
        end

        group #faf6f1 Dimensão Organizacional

            JaCaMo -> JaCaMo: platform.Moise.init()
            JaCaMo -> JaCaMo: platform.Sai.init()
        end

        group #faf6f1 Instanciação da Dimensão dos Agentes

        JaCaMo -> Jason : infra.JaCaMoLauncher.createAgs()
        activate Jason
        Jason -> Jason : infra.local.RunLocalMAS.createAgs()
        Jason -> Jason : mas2j.AgentParameters.addArchClass()

        Jason -> Jason : infra.local.LocalAgArch.<init>
        

        Jason -> Jason : infra.local.LocalAgArch.createArchs()
        Jason -> Jason : asSemantics.Agent.<init>
        Jason -> Jason : asSemantics.Agent.create()
        Jason -> Jason : asSemantics.Agent.initAg()
        Jason -> Jason : bb.DefaultBeliefBase.<init>
        Jason -> Jason : pl.PlanLibrary.<init>
        Jason -> Jason : pl.PlanLibrary.add()
        Jason -> Jason : asSemantics.Agent.addInitBel()
        Jason -> Jason : asSemantics.Agent.addInitialGoalsInTS()
        return
        
        JaCaMo -> JaCaMo : infra.JaCaMoAgArch.<init>
        

        JaCaMo -> Jason : infra.JaCaMoAgArch.init()
        activate Jason
        Jason -> JaCa : architecture.AgArch.<init>
        activate JaCa

        JaCa -> JaCa : CAgentArch.<init>
        JaCa -> JaCa : CAgentArch.initBridge()

        JaCa -> CArtAgO : CartagoEnvironment.startSession()
        activate CArtAgO

        CArtAgO -> CArtAgO : ObsProperty.<init>
        CArtAgO -> CArtAgO : Artifact.defineObsProperty()
        return
        return
        return
        

    group #FFF2CC Instanciação Corporal dos Agentes

        JaCaMo -> NECK : infra.JaCaMoAgArch.embody()
        activate NECK
        NECK -> NECK : Body.<init>
        NECK -> NECK : Body.attachApparatus()
        NECK -> NECK : DefaultApparatus.<init>
        NECK -> NECK : Apparatus.<init>
        NECK -> DEVICE : Apparatus.connect()
        activate DEVICE
        DEVICE -> DEVICE :  setup()
        DEVICE -> DEVICE : Serial.begin(115200bps)
        return
        
        
        NECK -> DEVICE : Apparatus.loadBodyActions()
        activate DEVICE
        DEVICE -> DEVICE :  JSON_SLP.incoming()
        DEVICE -> DEVICE : Apparatus.streamActions()
        return

        NECK -> DEVICE : Apparatus.loadTacitKnowledge()
        activate DEVICE
        DEVICE -> DEVICE :  JSON_SLP.incoming();
        DEVICE -> DEVICE : Apparatus.streamKnowHow()
        return
        NECK -> Jason : Apparatus.addPlan()

        activate Jason
        Jason -> Jason : pl.PlanLibrary.add()
        Jason --> NECK
        deactivate Jason
        NECK --> JaCaMo 
        deactivate NECK
        end
        end

        
    end
== FIM DO CARREGAMENTO O SISTEMA MULTIAGENTE ==

