== INICIO DA INICIALIZAÇÃO DO SISTEMA ==
group infra.JaCaMoLauncher.start()
    group #faf6f1 Iniciando Organização

    JaCaMo -> JaCaMo : project.JaCaMoProject.getInstitutions()
    JaCaMo -> JaCaMo : project.JaCaMoProject.getOrgPaths()
    JaCaMo -> CArtAgO : platform.Sai.start()
    activate CArtAgO
    CArtAgO -> CArtAgO : Workspace.createWorkspace()
    /'CArtAgO -> CArtAgO : WorkspaceId.<init>'/
    CArtAgO -> CArtAgO : Workspace.joinWorkspace
    CArtAgO -> CArtAgO : Workspace.makeArtifact()
    
    CArtAgO -> SAI : Artifact.doInit()
    activate SAI
    SAI -> SAI : bridges.jacamo.ConstitutiveArt.init()
    SAI -> SAI : main.institution.SaiEngine.<init>
    SAI -> SAI : main.institution.ConstitutiveReasoner.<init>
    SAI -> SAI : util.reasoner.jason.JasonReasoner.assertRule()
    SAI -> SAI : bridges.jacamo.RuleEngine.addInstitution()
    
    
    /' TIREI PQ O SAI USA O JASON COMO MOTOR... ESSA CRENÇA É A CRENÇA NA MENTE DO AGENTE?
    SAI -> Jason : util.reasoner.jason.JasonReasoner.assertRule()
    activate Jason
    Jason -> Jason : asSemantics.Agent.addBel()
    return
    '/

    SAI -> SAI : bridges.jacamo.ConstitutiveArt.loadConstitutiveProgram()
    return
    

    return

    JaCaMo -> CArtAgO : platform.Moise.start()

    activate CArtAgO
        CArtAgO -> CArtAgO : Workspace.createWorkspace()
        CArtAgO -> CArtAgO : Workspace.joinWorkspace()
        CArtAgO -> CArtAgO : Workspace.makeArtifact()
        
            CArtAgO -> ORA4MAS : Artifact.doInit()
            activate ORA4MAS
            ORA4MAS -> Moise : nopl.OrgBoard.init()
                activate Moise
                Moise -> Moise : common.MoiseElement.<init>
                Moise -> Moise : common.MoiseElement.setId()
                return
            return
        
    
        CArtAgO -> ORA4MAS : Artifact.doOperation()
        activate ORA4MAS
        ORA4MAS -> ORA4MAS : nopl.OrgBoard.createScheme()
        ORA4MAS -> ORA4MAS : nopl.OrgBoard.createGroup()
        ORA4MAS -> ORA4MAS : nopl.GroupBoard.init()
        ORA4MAS -> ORA4MAS : nopl.SchemeBoard.init()

        ORA4MAS -> NPL : nopl.OrgArt.initNormativeEngine()
            activate NPL
            NPL -> NPL : parser.nplp.<init>
            NPL -> NPL : parser.nplp.scope()
            NPL -> NPL : parser.nplp.inference_rule()
            NPL -> NPL : parser.nplp.norm()
            NPL -> NPL : parser.nplp.deontic_operator()
            NPL -> NPL : NPLInterpreter.init()
            NPL -> NPL : NPLInterpreter.loadNP()
            return
        return
    return
    end


    group #faf6f1 Iniciando o Ambiente
    JaCaMo -> CArtAgO : Cartago.start()
    activate CArtAgO
    CArtAgO -> CArtAgO : Workspace.createWorkspace()
    CArtAgO -> CArtAgO : Workspace.makeArtifact()
    CArtAgO -> CArtAgO : Artifact.bind()
    CArtAgO -> CArtAgO : Artifact.doInit()
    CArtAgO --> JaCaMo
    deactivate CArtAgO
    end




group Iniciando Dimensão dos Agentes
JaCaMo -> Jason : infra.JaCaMoLauncher.startAgs()
activate Jason
Jason -> Jason : RunLocalMAS.startAgs()
Jason -> Jason : jason.infra.local.RunLocalMAS.createAgsThreads()
end
end

newpage

Jason -> Jason : infra.local.LocalAgArch.run
== Ciclo de vida dos agentes ==


group jason.infra.local.LocalAgArch.reasoningCycle()

    group jason.infra.local.LocalAgArch.sense
        Jason -> JaCa : asSemantics.TransitionSystem.sense
        activate Jason
        activate JaCa
        JaCa -> JaCa : CAgentArch.perceive
        activate JaCa
        JaCa -> JaCa : CAgentArch.perceiveActionSucceeded
        JaCa -> JaCa : CAgentArch.perceiveActionFailed
        JaCa -> JaCa : CAgentArch.perceiveDispose
        JaCa -> JaCa : CAgentArch.perceiveSignal
        JaCa -> JaCa : CAgentArch.perceivedChangedOP
        JaCa -> JaCa : CAgentArch.perceiveAddedOP
        JaCa -> JaCa : CAgentArch.perceiveRemovedOP
        return
        JaCa -> Jason : CAgentArch.addObsPropertiesBel
        activate Jason
        Jason -> Jason : bb.DefaultBeliefBase.add
        return
        return
        
        Jason -> JaCaMo : architecture.AgArch.perceive
        activate JaCaMo
        JaCaMo -> NECK : infra.JaCaMoAgArch.perceive
        activate NECK
        group #FFF2CC percepcao Corporal
            NECK -> NECK : Body.sense
            activate NECK
            NECK -> DEVICE : Apparatus.sense
            activate DEVICE
            DEVICE -> DEVICE :  JSON_SLP.incoming()
            DEVICE -> DEVICE : Apparatus.streamPercepts()
            return

            NECK -> Jason : Body.updatePercepts
            activate Jason
            Jason -> Jason : bb.DefaultBeliefBase.add
            return

            NECK -> Jason : Body.updateDesires
            activate Jason
            Jason -> Jason : asSemantics.Circumstance.addEvent
            return
            return
        end
        return
        return

        
        Jason -> Jason : architecture.AgArch.checkMail
        activate Jason
        Jason -> Jason : asSemantics.Circumstance.addEvent
        return
        deactivate Jason

    end

    group deliberate
    Jason -> Jason : asSemantics.TransitionSystem.deliberate
    activate Jason
        Jason -> Jason: asSemantics.TransitionSystem.applySelEv();
        Jason -> Jason: asSemantics.TransitionSystem.applyRelPl();
        Jason -> Jason: asSemantics.TransitionSystem.applyApplPl();
        Jason -> Jason: asSemantics.TransitionSystem.applySelAppl();
        Jason -> Jason: asSemantics.TransitionSystem.applyFindOp();
        Jason -> Jason: asSemantics.TransitionSystem.applyAddIM();
    return
    end

    group jason.infra.local.LocalAgArch.act
    Jason -> Jason : infra.local.LocalAgArch.act
    end



end

deactivate JaCaMo

@enduml


