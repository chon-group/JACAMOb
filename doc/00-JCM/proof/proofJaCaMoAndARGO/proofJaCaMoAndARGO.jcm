mas proofJaCaMoAndARGO {

  agent rosie{
    ag-arch: jason.Argo

    /* initial mental state */
    beliefs: ecoMode(on)
    goals: helloWorld

    /* initial environment relationship */
    join: livingRoom
    focus: livingRoom.presenceSensor
    focus: livingRoom.airConditioner

    /* initial organizational relationship */
    focus: jetsonsInstitution.jetsonsInstitution_art
    roles: housekeeper in householdStaff
  }

  workspace livingRoom {
    artifact presenceSensor : jetsons.home.PresenceSensor()
    artifact airConditioner : jetsons.home.AirConditioner()
  }

  institution jetsonsInstitution : jetsonsInst.sai {
    workspaces: livingRoom
  }

  organisation jetsonsFamily : jetsons.xml {
      group householdStaff : householdGroup {
          responsible-for: greetPeople
      }

      scheme greetPeople : greetingScheme

      situated: jetsonsInstitution
  }

  uses package: argo "com.github.chon-group:Argo:1.2.6"
}
