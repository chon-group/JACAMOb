mas proofJaCaMoAndJavino {
 agent rosie{
  join: myBody
  focus: myBody.duster
  focus: myBody.battery
 }

 workspace myBody {
  artifact duster     : myBody.Duster("/dev/ttyUSB0") 
  artifact battery    : myBody.Battery("/dev/ttyEmulatedPort0") 
 }

}